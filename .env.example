# Copy these into Vercel: Project -> Settings -> Environment Variables
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=          # Supabase -> Project Settings -> API -> service_role (secret!)
ADMIN_KEY=                     # any long random string; you type it into the dashboard once
PUBLIC_URL=https://your-app.vercel.app
WA_VERIFY_TOKEN=               # any random string; paste the same value in Meta's webhook setup
WA_APP_SECRET=                 # Meta app -> App settings -> Basic -> App secret (verifies webhooks)
GRAPH_VERSION=v23.0
