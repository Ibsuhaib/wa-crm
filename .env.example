# Copy into Vercel: Project -> Settings -> Environment Variables (and into .env.local for scripts).
# Keep comments on their own lines: "KEY=value  # note" breaks `vercel dev`.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
# service_role key (secret!)
SUPABASE_SERVICE_KEY=

# Platform admin login. Any long random string.
ADMIN_KEY=
# Signs login sessions. 32+ random characters. Changing it logs everyone out.
SESSION_SECRET=
# Vercel Cron sends this to /api/cron/birthdays. Any long random string.
CRON_SECRET=

PUBLIC_URL=https://crm.hungriar.app

# Any random string; paste the same value in Meta's webhook setup.
WA_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret. Webhooks are rejected without it.
WA_APP_SECRET=
GRAPH_VERSION=v23.0
